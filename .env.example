POSTGRES_USER=findata
POSTGRES_PASSWORD=changeme
POSTGRES_DB=findata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=transactions

PRODUCER_RATE_PER_SEC=5
PRODUCER_MODE=stream
PRODUCER_BATCH_SIZE=1000

SPARK_TRIGGER_MODE=continuous

# --- Airflow ---
# Fernet key encrypts stored connection/variable secrets; a stable value means
# they survive a container recreate (a random per-boot key would orphan them).
# Airflow encrypts stored Connection/Variable passwords with this key. It must
# be 32 url-safe base64-encoded bytes - an arbitrary string like "changeme"
# fails with "Fernet key must be 32 url-safe base64-encoded bytes".
# Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left empty, Airflow runs without encryption and warns - fine for a local demo.
AIRFLOW_FERNET_KEY=
# Signs the Airflow webserver's session cookies; any random string works.
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# --- pipeline doctor ---
ANTHROPIC_API_KEY=changeme
# PIPELINE_DOCTOR_LLM_MODEL is deliberately unset: it defaults per provider
# (claude-opus-5 for anthropic, gemini-2.5-flash for google). Pinning it here
# would send one provider's model name to the other's API.
PIPELINE_DOCTOR_LLM_PROVIDER=anthropic
PIPELINE_DOCTOR_MAX_RETRIES=3
PIPELINE_DOCTOR_ROW_COUNT_DRIFT_PCT=0.20
PIPELINE_DOCTOR_NULL_RATE_DRIFT_PCT=0.10
PIPELINE_DOCTOR_CATEGORICAL_DRIFT_PVALUE=0.05
PIPELINE_DOCTOR_KS_PVALUE_THRESHOLD=0.05
PIPELINE_DOCTOR_HUMAN_GATE_MIN_SEVERITY=medium
PIPELINE_DOCTOR_CHECKPOINT_DB=checkpoints/pipeline_doctor.sqlite
PIPELINE_DOCTOR_BASELINE_DIR=data/baselines
