# LLM provider config, shared by self_heal and triage nodes (see src/pipeline_doctor/llm/client.py)
ANTHROPIC_API_KEY=
PIPELINE_DOCTOR_LLM_MODEL=claude-opus-5

# Retry / drift thresholds (defaults live in config/settings.py; override here per-environment)
PIPELINE_DOCTOR_MAX_RETRIES=3
PIPELINE_DOCTOR_ROW_COUNT_DRIFT_PCT=0.20
PIPELINE_DOCTOR_NULL_RATE_DRIFT_PCT=0.10
PIPELINE_DOCTOR_CATEGORICAL_DRIFT_PVALUE=0.05
PIPELINE_DOCTOR_KS_PVALUE_THRESHOLD=0.05
PIPELINE_DOCTOR_HUMAN_GATE_MIN_SEVERITY=medium

# Local storage paths (gitignored; regenerable)
PIPELINE_DOCTOR_CHECKPOINT_DB=checkpoints/pipeline_doctor.sqlite
PIPELINE_DOCTOR_BASELINE_DIR=data/baselines
